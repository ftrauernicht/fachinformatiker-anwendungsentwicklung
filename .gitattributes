# Zeilenenden im Repository immer LF, im Arbeitsverzeichnis plattformüblich.
# Ohne diese Zeile committen Windows-Clients CRLF und jeder Diff wird unlesbar.
* text=auto eol=lf

*.md       text diff=markdown
*.yml      text
*.yaml     text
*.py       text diff=python
*.ps1      text eol=crlf

# Binärdateien nie umschreiben und nie zeilenweise diffen
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.pdf      binary
*.svg      text

# Aus GitHubs Sprachstatistik heraushalten – dies ist ein Doku-Repository
docs/**    linguist-documentation
