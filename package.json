{
  "name": "fi-ae",
  "version": "0.0.0",
  "private": true,
  "description": "Werkzeuge zur Qualitaetssicherung der Pruefungsvorbereitung FIAE",
  "scripts": {
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "lint:spell": "cspell --no-progress --show-suggestions \"**/*.md\"",
    "check:content": "python tools/check_content.py",
    "check": "npm run lint:md && npm run lint:spell && npm run check:content"
  },
  "devDependencies": {
    "@cspell/dict-de-de": "^4.1.1",
    "cspell": "^8.19.4",
    "markdownlint-cli2": "^0.18.1"
  }
}
